# Expenso secrets. Copy this file to worker/.dev.vars and fill in the values.
# Never commit real values. In production these are set with `wrangler secret put`.

# Google AI Studio API key (free tier)
GEMINI_API_KEY=

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string; Telegram echoes it back on every webhook call.
# `npm run telegram -- secret` prints a suitable one.
TELEGRAM_WEBHOOK_SECRET=

# The public https address of the web app (e.g. a Cloudflare tunnel or workers.dev
# address). "Continue on web" links point here. Without it, the bot offers codes only.
PUBLIC_WEB_URL=

# Optional. Key for hashing the short handoff codes; the webhook secret is used if empty.
LINK_CODE_KEY=
