# Expenso secrets. Copy this file to worker/.dev.vars and fill in the values.
# Never commit real values. In production these are set with `wrangler secret put`.

# Google AI Studio API key (free tier)
GEMINI_API_KEY=

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string; Telegram echoes it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
