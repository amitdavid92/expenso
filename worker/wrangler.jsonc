{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expenso",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The built React app. Requests that match a file are served directly (free);
  // /api/* and /webhooks/* always reach the Worker first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },

  // Not secrets. Secrets (API keys, tokens) live in .dev.vars locally and in
  // `wrangler secret put` in production; see src/env.d.ts.
  "vars": {
    // Must be a model with a free tier. See README for how it was chosen.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Caps on Gemini requests (not messages: one message can take several; retries count too).
    // Verified free-tier quota for this model in AI Studio: 15 requests/minute, 500 requests/day.
    // Daily counters follow US Pacific days, which is when Gemini's own quota resets.
    "USER_DAILY_LLM_LIMIT": "60",
    "APP_DAILY_LLM_LIMIT": "400",
    // Rolling 60-second window, whole application.
    "APP_PER_MINUTE_LLM_LIMIT": "12",
    // Public address of the web app; handoff links point here. Local .dev.vars overrides it.
    "PUBLIC_WEB_URL": "https://expenso.expenso-worker.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expenso",
      // The production database. Local development and tests use a local copy.
      "database_id": "5cdf72b4-422d-4b98-9466-2861b7700dfc",
      "migrations_dir": "migrations"
    }
  ]
}
