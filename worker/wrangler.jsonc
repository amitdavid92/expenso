{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expenso",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The built React app. Requests that match a file are served directly (free);
  // /api/* and /webhooks/* always reach the Worker first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expenso",
      // Placeholder: replaced with the real id when the remote database is created (Phase 5).
      // Local development and tests do not use it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
